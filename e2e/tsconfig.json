{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "ES6"],
    "outDir": "lib",
    "module": "preserve",
    "declaration": true,
    "target": "ES6",
    "types": ["node"],
    "moduleResolution": "bundler",
    "paths": {
      "fixtures/*": ["./fixtures/*"]
    }
  },
  "include": [
    "tests/**/*",
    "fixtures/**/*",
    "stories/**/*",
    ".storybook/**/*",
    "playwright/playwright.config.ts"
  ]
}
