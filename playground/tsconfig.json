{
  "extends": "@gravity-ui/tsconfig/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "es2022",
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "paths": {
      "@local/transform/*": [
        "../lib/*"
      ],
      "@local/transform-dist/*": [
        "../dist/*"
      ],
      "src/*": [
        "./src/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
