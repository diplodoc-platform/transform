{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2018"],
    "outDir": "lib",
    "module": "node16",
    "declaration": true,
    "target": "ES2018",
    "types": ["node", "vitest/globals"],
    "moduleResolution": "node16"
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "lib", "dist", "e2e", "playground"]
}
