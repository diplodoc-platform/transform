{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2018"],
    "outDir": "lib",
    "module": "Node16",
    "declaration": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "target": "ES2018",
    "types": ["node"],
    "sourceMap": true,
    "rootDir": "./src/transform",
    "moduleResolution": "Node16"
  },
  "include": ["src/transform/**/*"]
}
